rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // File records are managed by the server (firebase-admin)
    // Here we define rules in case of direct client access (though server bypasses them)
    match /files/{fileId} {
      allow read: if true; // Public and Private access controlled by logic or code
      allow write: if false; // Only server can write
    }
  }
}
