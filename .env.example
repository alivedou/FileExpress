# 应用核心配置
APP_NAME=File Express
APP_SUBTITLE=极简、安全、临时的文件传输中心
APP_PORT=3000

# 文件体积与存储限制 (单位: MB)
MAX_SINGLE_FILE_SIZE_MB=10
MAX_ZIP_PAYLOAD_SIZE_MB=50
MAX_TOTAL_STORAGE_MB=1024

# 业务逻辑限制
MAX_STORAGE_HOURS=24
MAX_DOWNLOADS=100

# 数据加密密钥 (用于 AES-256-GCM)
# 重要：部署时请设置为一个长随机字符串 (推荐使用 UUID)
# 一旦文件存入，修改密钥将导致之前存入的私密文件无法解密提取
STORAGE_ENCRYPTION_KEY=8664183d-3b8f-431f-9988-6622b72f104d
