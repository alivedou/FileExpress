# 运行环境
NODE_ENV=production

# 应用核心配置
APP_NAME=File Express
APP_SUBTITLE=极简、安全、临时的文件传输中心

# 外部访问端口（VPS 上为宿主机端口；Railway 等平台由 PORT 环境变量自动注入）
PORT=3000

# 文件体积与存储限制 (单位: MB)
MAX_SINGLE_FILE_SIZE_MB=10
MAX_ZIP_PAYLOAD_SIZE_MB=50
MAX_TOTAL_STORAGE_MB=1024

# 业务逻辑限制
MAX_STORAGE_HOURS=24
MAX_DOWNLOADS=100

# 数据加密密钥 (用于 AES-256-GCM)
# 重要：部署时请设置为一个长随机字符串 (推荐使用 UUID)
# 一旦文件存入，修改密钥将导致之前存入的私密文件无法解密提取
STORAGE_ENCRYPTION_KEY=replace-with-32-byte-random-secret

# 企业版存储与续传
DATA_DIR=./data
STORAGE_BACKEND=local
STORAGE_BACKENDS=local
MAX_CHUNK_SIZE_MB=8
MAX_CONCURRENT_CHUNKS=3
UPLOAD_EXPIRY_HOURS=24
LARGE_FILE_THRESHOLD_MB=100
WEBHOOK_SIGNING_SECRET=replace-with-independent-32-byte-secret
ADMIN_API_TOKEN=replace-with-long-random-admin-token

# 可选云后端（只保留一个示例；真实值由 Secret 注入）
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=example-only
AWS_SECRET_ACCESS_KEY=example-only
S3_BUCKET=fileexpress
S3_ENDPOINT=http://localhost:9000
AZURE_STORAGE_CONNECTION_STRING=example-only
DATABASE_URL=postgres://postgres:example-only@localhost:5432/fileexpress
IPFS_API_URL=http://localhost:5001
IPFS_API_TOKEN=example-only

# 可选事件与可观测性基础设施
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092
OTEL_SERVICE_NAME=fileexpress
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
CLAMAV_URL=http://localhost:8080
VIRUSTOTAL_API_KEY=example-only
